# Resident Agent v1.0 — mẫu biến môi trường. Xem specs/OPERATIONS.md §3.
# CẤM điền giá trị thật vào file này. Sao chép sang .env.local rồi điền
# (.env.local bị .gitignore chặn, không được commit — OP-C6).

# Chuỗi kết nối Postgres, có ?sslmode=require. Bắt buộc khi DATA_BACKEND=postgres.
#
# Đ25 — nhà cung cấp chốt là SUPABASE (Postgres thật: có pgvector, unaccent,
# tsvector/ts_rank_cd — xem plan.md §2 Đ25 để biết vì sao Turso bị bác).
# Driver là `pg`, nói chuyện được với mọi Postgres chuẩn.
#
# BẮT BUỘC dùng chuỗi CONNECTION POOLER, không phải cổng trực tiếp:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#              (Supabase Dashboard → Project Settings → Database → Connection pooling,
#               mode `transaction`, cổng 6543)
# Cổng 5432 trực tiếp chỉ dùng cho script CLI chạy một lần (db:migrate, db:seed:*).
DATABASE_URL=

# Khoá API Gemini. Chỉ được đọc trong lib/adapters/model.ts (BB-07, Đ17).
# CẤM in ra log dưới mọi hình thức. Bắt buộc.
GEMINI_API_KEY=

# Bí mật ký cookie phiên HMAC, >= 32 byte ngẫu nhiên. Bắt buộc.
SESSION_SECRET=

# lexical | hybrid. Mặc định hybrid — CẢ local lẫn Vercel (Đ18, OP-C8 đã gỡ).
RETRIEVAL_MODE=hybrid

# mock | postgres. Mặc định mock khi chưa có DATABASE_URL (Đ24, H04).
# lib/pipeline/ đi qua lib/adapters/db.ts, KHÔNG gọi thẳng store-mock.ts.
DATA_BACKEND=mock

# Mật khẩu demo cho hai tài khoản seed. Chỉ dùng lúc chạy db:seed:users.
SEED_RESIDENT_PASSWORD=
SEED_BQL_PASSWORD=

# Tuỳ chọn: "1" bật chế độ dự phòng bỏ qua A2/A3 (OPERATIONS.md §7). Để trống
# nghĩa là tắt.
KILL_SWITCH_AGENTS=

# Tuỳ chọn, CHỈ local: ghi đè now() cho kịch bản demo giờ đóng cửa. CẤM đặt
# trên Vercel (OP-C2).
DEMO_CLOCK_ISO=
