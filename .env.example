# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# mock: rule-based, no API key needed (dev/test). openai: call the model in MODEL_NAME
LLM_MODE=mock
OPENAI_API_KEY=sk-your-key-here
# OpenAI-compatible endpoint. Key OpenRouter (sk-or-...) cần dòng này; để trống = api.openai.com
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=gpt-4o-mini

# MaintenanceOps: run the 5-minute retry/escalation job inside the API process
MO_JOBS_ENABLED=true

# ---- MaintenanceOps reasoning agent (plan 06) ----
# The agent decides only with LLM_MODE=openai + a key; mock (default) keeps the rule path.
# DeepSeek (OpenAI-compatible) example, set these in your real .env (never commit a key):
#   LLM_MODE=openai
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_API_KEY=
#   MODEL_NAME=deepseek-chat
# false = old LLM path (proposer) or rules
MO_AGENT_ENABLED=true
# Past this many seconds the call is a TIMEOUT and the rules decide
MO_AGENT_TIMEOUT_SECONDS=25
# A reply cut by this limit is INVALID_JSON and the rules decide
MO_AGENT_MAX_OUTPUT_TOKENS=2500
# json_object | prompt_only (use prompt_only when the endpoint rejects response_format)
MO_AGENT_JSON_MODE=json_object
# Local photo folder (MO_PHOTO_STORE=local)
MO_UPLOAD_DIR=./data/uploads/maintenance
# Accept X-Actor-Id instead of a login token (tests/scripts only; never enable in production)
MO_ALLOW_ACTOR_HEADER=false
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL) ----
# Used by docker compose to create the db container
POSTGRES_USER=p151
POSTGRES_PASSWORD=p151
POSTGRES_DB=p151
POSTGRES_PORT=5432
# Used as is by uvicorn on the host AND by the docker backend (compose no longer points it at the local "db")
# Keep ONE DATABASE_URL line only: local (below) or the shared Supabase one (commented further down).
DATABASE_URL=postgresql+psycopg2://p151:p151@localhost:5432/p151

# ---- MaintenanceOps persistence (plan 01) ----
# memory = in RAM like v0.5 (tests, offline demo); postgres = DATABASE_URL (Supabase team DB or local docker)
MO_STORE=memory
# On start, load the 12 fixture tickets only when the store has no ticket (never wipes anything)
MO_SEED_ON_EMPTY=true
# POST /mo/reset and /mo/evaluate wipe data: allowed with MO_STORE=memory; on a shared DB only the owner turns this on, briefly
MO_ALLOW_RESET=false
# One JSON line per model call (ts, ticket, model, status, latency_ms, prompt/completion/total tokens) for the team; not exposed by any API. "off" disables
MO_LATENCY_LOG=data/logs/latency.jsonl
# local = MO_UPLOAD_DIR; supabase = SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY + SUPABASE_STORAGE_BUCKET
MO_PHOTO_STORE=local
# Tests only (pytest --pg): local docker database whose name ends with _test
# MO_TEST_DATABASE_URL=postgresql+psycopg2://p151:p151@localhost:5432/p151_test
# Schema maintops is created by Alembic, never at startup (owner, once per revision):
#   python -m alembic -c src/maintenance/store/alembic.ini upgrade head

# ---- Supabase (shared team DB + photo storage) ----
# Ask the project owner to invite you to the "Build Phase" org (role Developer); take every value
# from the Dashboard yourself. Never paste keys or passwords into chat, docs or git.
# Not a secret: Dashboard → project home → Project URL
SUPABASE_URL=https://aznecwoyeravoupqbjbd.supabase.co
# SECRET: Project Settings → API Keys → Secret keys → "New secret key" named after you (sb_secret_...).
# Not the publishable key: it cannot write to a private bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket: 5 MB limit, image/jpeg, image/png, image/webp
SUPABASE_STORAGE_BUCKET=maintenance-photos
# Shared DB: replace the local DATABASE_URL above with this line.
# Connect → Direct "Connection string" → Method "Session pooler" (not Direct: IPv6 only).
# User = your own role created in SQL Editor (create role <name> login password '...' in role maintops_dev),
# written as <name>.<project-ref>. Letters/digits-only password, otherwise URL-encode it.
# DATABASE_URL=postgresql+psycopg2://<name>.aznecwoyeravoupqbjbd:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
