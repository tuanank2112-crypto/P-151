# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# mock: rule-based, no API key needed (dev/test). openai: call the model in MODEL_NAME
LLM_MODE=mock
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL) ----
# Used by docker compose to create the db container
POSTGRES_USER=p151
POSTGRES_PASSWORD=p151
POSTGRES_DB=p151
POSTGRES_PORT=5432
# For running uvicorn on the host (docker compose overrides this with host "db")
DATABASE_URL=postgresql+psycopg2://p151:p151@localhost:5432/p151

# ---- Zalo Bot (notify technicians) ----
# Token from the Zalo Bot creator; keep secret
ZALO_BOT_TOKEN=
# Secret to verify incoming webhook requests from Zalo
ZALO_WEBHOOK_SECRET=
# Chat ID of the technician group/user that receives work orders
ZALO_TECH_CHAT_ID=

# ---- Maintenance ops ----
# Ticket evidence photos (./data is mounted into the backend container)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
# Load demo data from seed/ when the DB is empty
SEED_ON_STARTUP=true
# Escalate to BQL after this many failed evidence checks
MAX_CHECK_FAILURES=2

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
