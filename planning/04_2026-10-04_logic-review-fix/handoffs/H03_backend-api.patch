diff --git a/tests/test_maintenance/test_backend_review_fixes.py b/tests/test_maintenance/test_backend_review_fixes.py
new file mode 100644
index 0000000..0e6f29e
--- /dev/null
+++ b/tests/test_maintenance/test_backend_review_fixes.py
@@ -0,0 +1,100 @@
+"""Plan 04 backend part (owner: API/Châm Anh): route limits, photo guard on /evidence, AI-log access and
+filtering, one queue order. Needs the router/auth changes of handoffs/H03_backend-api.patch."""
+
+import pytest
+from fastapi.testclient import TestClient
+
+from src.api.auth import actor_header_allowed
+from src.api.routers.maintenance import get_engine
+from src.main import app
+from src.maintenance.ai_logger import ai_logger
+from src.maintenance.views import queue_sort_key
+from tests.test_maintenance.helpers import (
+    BPTN,
+    BQL,
+    CLEANING,
+    OTHER_RESIDENT,
+    RESIDENT,
+    TEC,
+    dept_of,
+    do_work,
+    report,
+)
+
+TIER2 = "Hành lang tầng 3 tòa SIM-A hình như có mùi khét."
+H = {name: {"X-Actor-Id": actor} for name, actor in {
+    "resident": RESIDENT, "other": OTHER_RESIDENT, "bptn": BPTN, "bql": BQL, "tec": TEC,
+    "cln": "SIM-ACTOR-DEPT-CLN-01", "warehouse": "SIM-ACTOR-WAREHOUSE-01",
+}.items()}  # fmt: skip
+
+
+@pytest.fixture
+def api_engine(fresh):
+    app.dependency_overrides[get_engine] = lambda: fresh
+    app.dependency_overrides[actor_header_allowed] = lambda: True
+    yield TestClient(app), fresh
+    app.dependency_overrides.pop(get_engine, None)
+    app.dependency_overrides.pop(actor_header_allowed, None)
+
+
+def test_attempt_route_rejects_oversized_values(api_engine):
+    api, engine = api_engine
+    tid = report(engine, CLEANING)
+    version_before = len(engine.get(tid).audit)
+    body = {"action": "EDIT_RAW", "field_name": "x", "new_value": "y" * 1_000_000}
+    assert api.post(f"/api/v1/mo/tickets/{tid}/attempt", json=body, headers=H["resident"]).status_code == 422
+    assert len(engine.get(tid).audit) == version_before
+
+
+# ---------------------------------------------------------------------- A2: no text "photo"
+
+
+def test_evidence_route_refuses_photo_types(api_engine):
+    api, engine = api_engine
+    tid = report(engine, CLEANING)
+    engine.accept(tid, dept_of(engine, tid))
+    for kind in ("SIMULATED_IMAGE", "RESIDENT_ORIGINAL"):
+        body = {"requirement_id": None, "evidence_type": kind, "content_or_metadata": "chữ"}
+        assert api.post(f"/api/v1/mo/tickets/{tid}/evidence", json=body, headers=H["cln"]).status_code == 422
+    do_work(engine, tid, photo=False)
+    r = api.post(f"/api/v1/mo/tickets/{tid}/complete", headers=H["cln"])
+    assert r.json()["ticket"]["status"] == "IN_PROGRESS"
+    assert "execution_photo" in r.json()["draft"]["readiness_evaluation"]["failing_items"]
+
+
+# ---------------------------------------------------------------------- A4: AI logs
+
+
+def test_ai_logs_only_for_roles_that_see_every_ticket(api_engine):
+    api, _ = api_engine
+    for who in ("cln", "warehouse"):
+        assert api.get("/api/v1/mo/ai-logs", headers=H[who]).status_code == 403
+    for who in ("bptn", "bql"):
+        assert api.get("/api/v1/mo/ai-logs", headers=H[who]).status_code == 200
+
+
+def test_ai_logs_filter_before_limit(api_engine):
+    api, _ = api_engine
+    ai_logger.clear()
+    ai_logger.log(ticket_id="SIM-TKT-0001", prompt_sent={}, model_name="m", latency_ms=1, status="SUCCESS")
+    for _ in range(3):
+        ai_logger.log(ticket_id="SIM-TKT-0002", prompt_sent={}, model_name="m", latency_ms=1, status="FALLBACK_RULE")
+    rows = api.get("/api/v1/mo/ai-logs?status=SUCCESS&limit=1", headers=H["bql"]).json()
+    assert [r["ticket_id"] for r in rows] == ["SIM-TKT-0001"]
+    ai_logger.clear()
+
+
+# ---------------------------------------------------------------------- L2: one queue order
+
+
+def test_internal_queue_uses_the_shared_sort_key(api_engine):
+    api, engine = api_engine
+    report(engine, CLEANING)
+    report(engine, "Đèn hành lang tầng 3 tòa SIM-A không sáng.")
+    tier2 = report(engine, TIER2)  # no priority yet
+    low = report(engine, "Sảnh chính tòa SIM-B có ít bụi ở góc tường.")  # PRI-L1
+    report(engine, "Có khói bốc ra từ hộp điện hành lang tầng 5 tòa SIM-B")
+    ids = [r["ticket_id"] for r in api.get("/api/v1/mo/tickets", headers=H["bql"]).json()]
+    expected = [c.ticket.ticket_id for c in sorted(engine.cases.values(), key=lambda c: queue_sort_key(c.ticket))]
+    assert ids == expected
+    assert ids.index(low) < ids.index(tier2)  # an unset priority goes after LOW, as in the BQL queue
