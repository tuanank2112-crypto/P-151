{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/_pyrun.sh\" \"$(git rev-parse --show-toplevel)/scripts/log_hook.py\" --tool=codex",
            "commandWindows": "for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @\"%R\\scripts\\_pyrun.cmd\" \"%R\\scripts\\log_hook.py\" --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "log-stop",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/_pyrun.sh\" \"$(git rev-parse --show-toplevel)/scripts/log_hook.py\" --tool=codex",
            "commandWindows": "for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @\"%R\\scripts\\_pyrun.cmd\" \"%R\\scripts\\log_hook.py\" --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
