# Local Python backend; Docker compose supplies http://backend:8000.
BACKEND_URL=http://127.0.0.1:8000
# Use true for HTTPS deployments. False supports local HTTP/LAN testing.
SESSION_COOKIE_SECURE=false
# Optional only for legacy rollback tests, never needed by frontend runtime.
TEST_DATABASE_URL=postgres://p151:p151@localhost:5432/portal_test